<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ================================================================ -->
    <!-- Project coordinates                                              -->
    <!-- ================================================================ -->
    <groupId>com.rosetta.experiment</groupId>
    <artifactId>atm-rewrite-test</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>ATM Simulator – OpenRewrite Call-Graph Experiment</name>
    <description>
        Sandboxed Maven wrapper around the legacy ATM-Simulator-System
        source to run OpenRewrite FindCallGraph without touching the
        original Ant/NetBeans project.
    </description>

    <!-- ================================================================ -->
    <!-- Global properties                                                -->
    <!-- ================================================================ -->
    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- OpenRewrite Maven plugin version (latest stable) -->
        <!-- NOTE: the plugin (6.x) and core rewrite-java (8.x) are on   -->
        <!--       different version tracks. The plugin resolves its own   -->
        <!--       compatible core version automatically — do NOT pin      -->
        <!--       rewrite-java manually here.                            -->
        <rewrite.plugin.version>6.46.1</rewrite.plugin.version>
    </properties>

    <!-- ================================================================ -->
    <!-- Dependencies                                                     -->
    <!-- The ATM source uses:                                             -->
    <!--   - java.awt / javax.swing (provided by the JDK itself)         -->
    <!--   - java.sql (provided by the JDK itself)                       -->
    <!--   - com.mysql.cj.jdbc.Driver  ← needs mysql-connector-j         -->
    <!--                                                                  -->
    <!-- Providing mysql-connector-j here gives OpenRewrite full type    -->
    <!-- information for all JDBC calls so they don't end up in          -->
    <!-- LowConfidenceFiles.                                              -->
    <!-- ================================================================ -->
    <dependencies>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.3.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- Signup.java uses JDateChooser from the jcalendar library -->
        <dependency>
            <groupId>com.toedter</groupId>
            <artifactId>jcalendar</artifactId>
            <version>1.4</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <!-- ================================================================ -->
    <!-- Build plugins                                                    -->
    <!-- ================================================================ -->
    <build>
        <plugins>

            <!-- Standard compiler plugin – explicit to avoid version drift -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- ========================================================= -->
            <!-- OpenRewrite Maven Plugin                                   -->
            <!--                                                            -->
            <!-- Recipe:  FindCallGraph                                     -->
            <!--   Emits one row per method call edge:                     -->
            <!--     callerClass, callerMethod, calleeClass, calleeMethod   -->
            <!--                                                            -->
            <!-- exportDatatables=true                                      -->
            <!--   Writes CSVs to:                                          -->
            <!--     target/rewrite/datatables/                            -->
            <!--   Relevant file:                                           -->
            <!--     org.openrewrite.java.search.FindCallGraph.csv         -->
            <!--                                                            -->
            <!-- Run with:                                                  -->
            <!--   mvn rewrite:run                                          -->
            <!-- (or if you only want the CSV without source changes:       -->
            <!--   mvn rewrite:dryRun  –– keeps source files untouched)   -->
            <!-- ========================================================= -->
            <plugin>
                <groupId>org.openrewrite.maven</groupId>
                <artifactId>rewrite-maven-plugin</artifactId>
                <version>${rewrite.plugin.version}</version>
                <configuration>
                    <!-- Correct fully-qualified recipe name.
                         FindCallGraph lives in org.openrewrite (root package),
                         NOT in org.openrewrite.java.search. -->
                    <activeRecipes>
                        <recipe>org.openrewrite.FindCallGraph</recipe>
                    </activeRecipes>
                    <!-- Dump CSVs to target/rewrite/datatables/ -->
                    <exportDatatables>true</exportDatatables>
                </configuration>
                <dependencies>
                    <!-- rewrite-all bundles FindCallGraph and all recipe modules.
                         Must be declared explicitly — it is NOT part of the base plugin. -->
                    <dependency>
                        <groupId>org.openrewrite.recipe</groupId>
                        <artifactId>rewrite-all</artifactId>
                        <version>1.28.1</version>
                    </dependency>
                </dependencies>
            </plugin>

        </plugins>
    </build>

</project>
